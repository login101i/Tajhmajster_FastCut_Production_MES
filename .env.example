# ─── Netlify Site settings → Environment variables ─────────────────────────
# Tak — Netlify przyjmuje hasła w env. NIGDY nie używaj prefiksu VITE_ dla haseł MySQL.

# MySQL (Cyberfolks / VPS) — musi być osiągalny z internetu (whitelist IP Netlify lub public host)



# Alternatywne nazwy (też działają):
# MYSQL_CYBERFOLKS_HOST=
# MYSQL_CYBERFOLKS_USER=
# MYSQL_CYBERFOLKS_PASSWORD=
# MYSQL_CYBERFOLKS_DATABASE=
# MYSQL_CYBERFOLKS_PORT=

# Hasło / token do monitora (opcjonalne, ale zalecane na produkcji)
# Klient wpisuje to samo w ekranie logowania aplikacji


# Frontend (opcjonalnie) — jeśli zostawisz puste, używa /api na tej samej domenie Netlify
# VITE_MONITOR_TOKEN=  ← tylko do lokalnego auto-login; nie commituj prawdziwego hasła
